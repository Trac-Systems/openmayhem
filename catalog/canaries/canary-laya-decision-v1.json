            "feature_request": "request a new feature",
            "integration_api": "API integration question",
            "integration_webhook": "webhook integration question",
            "mobile_app": "mobile application problem",
            "performance": "slow application performance",
            "privacy": "privacy question",
            "security": "security concern",
            "service_outage": "service is unavailable",
            "shipping": "physical shipment question",
            "team_members": "manage team members",
            "two_factor": "two-factor authentication problem",
            "usage_limits": "usage quota or limit",
            "verification": "identity or email verification",
            "website_bug": "website error",
            "other": "none of the listed categories"
          }
        }
      },
      "checkpoint": "english",
      "shortlist": {
        "k": 20,
        "max_length": 512,
        "batch_size": 16
      }
    },
