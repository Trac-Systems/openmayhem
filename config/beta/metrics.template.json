        "<provider-roster-report-hash-or-url>"
      ]
    },
    "users": {
      "count": "<user-count-at-least-100>",
      "evidence": [
        "<user-activity-report-hash-or-url>"
      ]
    }
  },
  "audited_epoch": {
    "epoch": "<audited-epoch-number>",
