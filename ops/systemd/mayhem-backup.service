[Unit]
Description=Quiesced Mayhem mainnet state and secret backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=mayhem
Group=mayhem
WorkingDirectory=/opt/mayhem/source
EnvironmentFile=/opt/mayhem/.mayhem-local/secrets/GO-LIVE/mayhem-systemd.env
UMask=0077
ExecStartPre=+/usr/bin/systemctl stop mayhem-paygate.service mayhem-tap-rate.service mayhem-tnk-rate.service mayhem-tap-deposit.service mayhem-tnk-deposit.service mayhem-tap-settlement.service mayhem-stack.service
ExecStart=/opt/mayhem/source/scripts/ops/backup-mainnet.sh
ExecStopPost=+/usr/bin/systemctl start mayhem-stack.service mayhem-paygate.service mayhem-tap-rate.service mayhem-tnk-rate.service mayhem-tap-deposit.service mayhem-tnk-deposit.service mayhem-tap-settlement.service
TimeoutStartSec=infinity
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
