[Unit]
Description=Mayhem mainnet peer, gateway, and fraud challenger
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=mayhem
Group=mayhem
WorkingDirectory=/opt/mayhem/source
EnvironmentFile=/opt/mayhem/.mayhem-local/secrets/GO-LIVE/mayhem-systemd.env
UMask=0077
ExecStartPre=/usr/bin/test -f /opt/mayhem/.mayhem-local/live-home/mayhemd-up.toml
ExecStart=/opt/mayhem/source/target/release/mayhemd --home /opt/mayhem/.mayhem-local/live-home --config /opt/mayhem/.mayhem-local/live-home/mayhemd-up.toml --bind 127.0.0.1:11437
ExecStartPost=/usr/bin/node /opt/mayhem/source/scripts/mainnet-proof.mjs --peer-rpc http://127.0.0.1:49223/v1 --timeout-seconds 0 --json
Restart=always
RestartSec=10
TimeoutStartSec=infinity
TimeoutStopSec=60
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
