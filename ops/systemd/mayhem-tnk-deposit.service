[Unit]
Description=Mayhem official-mainnet TNK deposit watcher
Requires=mayhem-stack.service
After=mayhem-stack.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=mayhem
Group=mayhem
WorkingDirectory=/opt/mayhem/source/intercom
EnvironmentFile=/opt/mayhem/.mayhem-local/secrets/GO-LIVE/mayhem-systemd.env
UMask=0077
ExecStartPre=/usr/bin/node /opt/mayhem/source/scripts/mainnet-proof.mjs --timeout-seconds 60 --json
ExecStart=/opt/mayhem/source/scripts/ops/run-tnk-deposit-watcher.sh
Restart=always
RestartSec=30
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
