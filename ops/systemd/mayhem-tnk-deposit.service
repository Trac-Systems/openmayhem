[Unit]
Description=Mayhem official-mainnet TNK deposit watcher
Requires=mayhem-stack.service
After=mayhem-stack.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=mayhem
Group=mayhem
WorkingDirectory=/opt/mayhem/source/intercom
EnvironmentFile=/opt/mayhem/.mayhem-local/secrets/GO-LIVE/mayhem-systemd.env
UMask=0077
ExecStartPre=/usr/bin/node /opt/mayhem/source/scripts/mainnet-proof.mjs --timeout-seconds 60 --json
ExecStart=/usr/bin/node /opt/mayhem/source/intercom/scripts/tnk-deposit-watcher.mjs --network mainnet --state-dir /opt/mayhem/.mayhem-local/tnk-deposit-msb --store-name mayhem-mainnet-deposit-watcher --peer-rpc http://127.0.0.1:49223/v1 --cursor /opt/mayhem/.mayhem-local/watchers/tnk-deposit.json --admin-home /opt/mayhem/.mayhem-local/live-home --mayhem-bin /opt/mayhem/source/target/release/mayhem --submit --json
Restart=always
RestartSec=30
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
